#!/../bin/madc
#define SMAUG 1
#include <stdio.h>
#include <crypt.h>
#include "upstream_src/mud.h"
#include "upstream_src/bet.h"
#include "upstream_src/hint.h"
#include "upstream_src/house.h"
#include "upstream_src/news.h"
// IMC (Inter-Mud Communication) is an optional federation feature
// in upstream SMAUG 1.8. Real installs `#ifdef IMC`-out when not
// running it. Defer all IMC ingestion until the non-IMC umbrella
// runs end-to-end; ingesting IMC just to bump parse % is hollow
// progress. Headers ingest cleanly today (post-`##` and
// `__attribute__` lexer fixes) — uncomment under `#ifdef IMC`
// once core runtime works.
#ifdef IMC
#include "upstream_src/imc-mercdefs.h"
#include "upstream_src/imc-mercbase.h"
#include "upstream_src/imc-config.h"
#include "upstream_src/imc.h"
#endif

#define bug(...) ((void)0)
#define ch_printf(...) ((void)0)
#define pager_printf(...) ((void)0)

#include "upstream_src/act_move.c"
#undef bug
#include "upstream_src/db.c"
#define bug(...) ((void)0)
#include "upstream_src/hashstr.c"
#include "upstream_src/handler.c"
#include "upstream_src/fight.c"
#include "upstream_src/skills.c"
#include "upstream_src/news.c"
#include "upstream_src/magic.c"
#include "upstream_src/mud_prog.c"
#include "upstream_src/stances.c"
#include "upstream_src/requests.c"
#include "upstream_src/act_comm.c"
#include "upstream_src/act_obj.c"
#include "upstream_src/boards.c"
#include "upstream_src/act_info.c"
#include "upstream_src/act_wiz.c"
#include "upstream_src/ban.c"
#include "upstream_src/comments.c"
#include "upstream_src/const.c"
#include "upstream_src/clans.c"
#include "upstream_src/colorize.c"
#include "upstream_src/deity.c"
#include "upstream_src/hint.c"
#include "upstream_src/grub.c"
#include "upstream_src/comm.c"
#include "upstream_src/tables.c"
#include "upstream_src/save.c"
#include "upstream_src/misc.c"
#include "upstream_src/reset.c"
#include "upstream_src/mapout.c"
#include "upstream_src/special.c"
#include "upstream_src/makeobjs.c"
#include "upstream_src/variables.c"
#include "upstream_src/update.c"
#include "upstream_src/imm_host.c"
#include "upstream_src/polymorph.c"
#include "upstream_src/planes.c"
#include "upstream_src/house.c"
#include "upstream_src/starmap.c"
#include "upstream_src/mud_comm.c"
#include "upstream_src/player.c"
#include "upstream_src/adminlist.c"
#include "upstream_src/track.c"
#include "upstream_src/build.c"
#include "upstream_src/stat_obj.c"
#include "upstream_src/renumber.c"
#include "upstream_src/services.c"
#include "upstream_src/mpxset.c"
#include "upstream_src/shops.c"
#include "_bootstrap_comm_shim.c"
#include "ibuild.c"
#include "ident.c"
#include "interp.c"

// Both function-scope and file-scope writes to fpLOG/fpReserve from
// our SMAUG.mad don't reach the db.c-defined globals — madc seems to
// shadow them. Workaround: stub boot_log so the fclose(fpLOG) crash
// doesn't fire (handled in _bootstrap_comm_shim.c).

int main(int argc, char **argv)
{
    fprintf(stderr, "[init] fpLOG=%p fpReserve=%p\n", (void*)fpLOG, (void*)fpReserve);
    fputs("[probe] before boot_db\n", stdout); fflush(stdout);
    boot_db();
    fputs("[probe] after boot_db\n", stdout); fflush(stdout);
    exit(0);
    return 0;
}
